# Formula for agentbus2: installs a prebuilt binary: a signed, notarized
# universal binary on macOS, a static binary on Linux (amd64 and arm64).
# Rendered from release/agentbus2.rb.tmpl by release/release.sh; do not edit
# the copy in the tap by hand.
#
# The host checks below are the layout Homebrew accepts for third-party taps
# that ship platform-specific URLs: `url`/`sha256` are not allowed inside
# `on_macos`/`on_linux` blocks (FormulaAudit/ComponentsOrder), and the
# OnSystemConditionals cop exempts non-core taps from the on_* rewrite.
class Agentbus2 < Formula
  desc "Message bus, shared memory and shared task queue for coding agents"
  homepage "https://github.com/ericfitz/agentbus2"
  license "Apache-2.0"

  if OS.mac?
    url "__MACOS_URL__"
    sha256 "__MACOS_SHA256__"
  elsif OS.linux? && Hardware::CPU.intel?
    url "__LINUX_AMD64_URL__"
    sha256 "__LINUX_AMD64_SHA256__"
  elsif OS.linux? && Hardware::CPU.arm?
    url "__LINUX_ARM64_URL__"
    sha256 "__LINUX_ARM64_SHA256__"
  end

  def install
    bin.install "agentbus2"
  end

  def caveats
    <<~EOS
      Register agentbus2 with your coding harnesses once per machine:
        agentbus2 init --global
      Then run `agentbus2 init` inside each repository.
    EOS
  end

  test do
    assert_equal version.to_s, shell_output("#{bin}/agentbus2 version").strip
  end
end
